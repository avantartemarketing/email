{
  "name": "aa-post-purchase-comms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Avant Arte post-purchase comms tool \u2014 batches, promise dates, milestone/delay emails behind an approval gate",
  "scripts": {
    "dev": "vite",
    "check": "node checks/prove-tokens.mjs && node checks/prove-kit.mjs",
    "check:screens": "node checks/prove-screens.mjs",
    "build": "npm run check && tsc -b && vite build",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build:artifact": "vite build --config vite.artifact.config.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.0"
  }
}
